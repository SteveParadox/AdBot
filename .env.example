# Generate real values with: python scripts/init_env.py
ADBOT_API_KEYS=
ADBOT_POSTGRES_PASSWORD=
ADBOT_ENVIRONMENT=development
ADBOT_DATABASE_URL=sqlite:///./adbot.db
ADBOT_REDIS_URL=
ADBOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required in production. Explicit hosts or *.example.com; no URLs.
ADBOT_AUTHORIZED_DOMAINS=
ADBOT_FIXTURE_MODE=false
ADBOT_FIXTURE_PORT=8765
ADBOT_MAX_CONCURRENCY=2
ADBOT_LEASE_SECONDS=90
ADBOT_ARTIFACT_DIR=./data/screenshots
ADBOT_RETENTION_DAYS=30
ADBOT_RATE_PER_MINUTE=120

# Goal-driven agent: keep disabled to run crawls without an LLM.
ADBOT_AI_PROVIDER=disabled
ADBOT_AI_MODEL=
ADBOT_AI_BASE_URL=https://api.openai.com/v1
ADBOT_AI_API_KEY=
ADBOT_GROQ_BASE_URL=https://api.groq.com/openai/v1
ADBOT_GROQ_API_KEY=
ADBOT_GROQ_MODEL=openai/gpt-oss-120b
# Optional cloud chain, in failover order; first entry must match AI_PROVIDER.
# ADBOT_AI_PROVIDER_ORDER=groq,openrouter,google,nvidia,groq_secondary
ADBOT_AI_PROVIDER_ORDER=
ADBOT_GROQ_SECONDARY_API_KEY=
ADBOT_GROQ_SECONDARY_MODEL=openai/gpt-oss-120b
ADBOT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ADBOT_OPENROUTER_API_KEY=
ADBOT_OPENROUTER_MODEL=openai/gpt-oss-120b
ADBOT_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ADBOT_GOOGLE_API_KEY=
ADBOT_GOOGLE_MODEL=gemini-3.8-flash
ADBOT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ADBOT_NVIDIA_API_KEY=
ADBOT_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
ADBOT_AI_FAILURE_COOLDOWN_SECONDS=30
ADBOT_AI_TIMEOUT_SECONDS=30
ADBOT_AI_FALLBACK_PROVIDER=disabled
ADBOT_AI_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
ADBOT_AI_FALLBACK_API_KEY=
ADBOT_AI_FALLBACK_MODEL=
ADBOT_AI_FALLBACK_TIMEOUT_SECONDS=60
ADBOT_AGENT_FALLBACK_TOKENS=10000
ADBOT_AI_RETRIES=2
ADBOT_AI_MAX_OUTPUT_TOKENS=800
ADBOT_AI_MAX_REQUEST_CHARS=18000
ADBOT_AI_JSON_MODE=true
# Reasoning budget for GPT-OSS on Groq and OpenRouter.
ADBOT_AI_REASONING_EFFORT=low
ADBOT_AGENT_MAX_STEPS=500
ADBOT_AGENT_MAX_TOKENS=60000
ADBOT_AGENT_MAX_TABS=4
ADBOT_AGENT_MAX_RETRIES=3
ADBOT_AGENT_MEMORY_ENABLED=true
ADBOT_AGENT_VISUAL_REASONING=false
ADBOT_BROWSER_SESSION_PERSISTENCE=false
# Generated by init_env.py; needed only if enabling session persistence.
ADBOT_SESSION_ENCRYPTION_KEY=

# Subset of ADBOT_API_KEYS allowed to manage public site content; empty disables editing.
ADBOT_CONTENT_ADMIN_KEYS=

# Security: no proxy is trusted until explicitly configured. Uvicorn proxy rewriting must stay off.
ADBOT_TRUSTED_PROXY_CIDRS=
ADBOT_ALLOWED_HOSTS=localhost,127.0.0.1
ADBOT_ENFORCE_HTTPS=false
# Enable only after the public HTTPS route and recovery access have been verified.
ADBOT_HSTS_ENABLED=false
ADBOT_PUBLIC_RATE_PER_MINUTE=600
# Hidden maps are for private error tooling; production Nginx denies .map requests.
ADBOT_BUILD_SOURCEMAPS=false

# Optional approved egress; disabled means original direct destination sockets behind the SSRF guard.
ADBOT_OUTBOUND_PROXY_ENABLED=false
ADBOT_OUTBOUND_PROXY_CONFIG_PATH=/run/secrets/outbound-proxies.json
ADBOT_OUTBOUND_CONNECT_TIMEOUT_SECONDS=5
ADBOT_OUTBOUND_REQUEST_TIMEOUT_SECONDS=15
ADBOT_OUTBOUND_MAX_RETRIES=2
ADBOT_OUTBOUND_HEALTH_INTERVAL_SECONDS=60
# UA strings are printable ASCII, preserved exactly; database manages runtime profiles/overrides.
ADBOT_USER_AGENT_DEFAULT=Adbot/1.0.0
ADBOT_USER_AGENT_MAX_LENGTH=512
ADBOT_USER_AGENT_ALLOW_REQUEST_OVERRIDES=false
# Only explicitly approved unauthenticated browser contexts may rotate. Empty disables rotation.
ADBOT_USER_AGENT_ROTATABLE_SERVICES=
# Optional JSON map of operator-required identities, e.g. {"ai":"ApprovedClient/1.0"}
ADBOT_USER_AGENT_FIXED_IDENTITIES={}

# Enable native Ollama schema output and worker warm-up for a local fallback.
ADBOT_AI_OLLAMA_NATIVE=false
ADBOT_AI_OLLAMA_WARMUP_TIMEOUT_SECONDS=300
ADBOT_AI_PRIMARY_FALLBACK_TIMEOUT_SECONDS=10

# Worker resource limits and extraction exports
ADBOT_MAX_IO_THREADS=4
ADBOT_MAX_PROXY_CONNECTIONS=64
ADBOT_EXTRACTION_MAX_EXPORT_BYTES=52428800
ADBOT_EXTRACTION_EXPORT_TTL_SECONDS=86400
ADBOT_MAX_CONCURRENT_AGENTS=2
ADBOT_MAX_BROWSER_SESSIONS=2
ADBOT_PRIORITY_AGING_SECONDS=300
ADBOT_RESOURCE_MONITORING_ENABLED=true
ADBOT_MAX_HOST_MEMORY_PERCENT=95
ADBOT_MAX_HOST_CPU_PERCENT=95

# Shared provider quota caps; 0 disables each cap.
ADBOT_AI_PROVIDER_RPM=0
ADBOT_AI_PROVIDER_TPM=0
